{
  "name": "bump-trade-3d",
  "version": "0.1.0",
  "description": "BUMP.TRADE 3D Gameplay Engine - Hero Car Milestone",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check src packages server indexer",
    "typecheck:all": "pnpm -r --workspace-concurrency=1 typecheck && pnpm typecheck",
    "test:all": "pnpm -r --workspace-concurrency=1 test"
  },
  "dependencies": {
    "@bump/contracts": "workspace:*",
    "@bump/shared": "workspace:*",
    "@colyseus/sdk": "0.18.5",
    "@dimforge/rapier3d-compat": "0.21.0",
    "motion": "^14.0.0",
    "three": "^0.186.1",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "@biomejs/biome": "2.5.15"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.12"
  }
}
